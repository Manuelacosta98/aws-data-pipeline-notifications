# ------------------------------------------------------------------
# Core deploy target (used by CDK to scope every stack).
# Leave blank to use whatever account/region the AWS CLI/SSO/profile points at.
# ------------------------------------------------------------------
CDK_DEFAULT_ACCOUNT=
CDK_DEFAULT_REGION=

# ------------------------------------------------------------------
# Slack workspace + channel for AWS Chatbot.
# SLACK_WORKSPACE_ID is the team/workspace ID (starts with "T...").
# SLACK_CHANNEL_ID is the channel ID (starts with "C...").
# Both are visible after you authorize AWS Chatbot in the Slack workspace.
# ------------------------------------------------------------------
SLACK_WORKSPACE_ID=
SLACK_CHANNEL_ID=

# ------------------------------------------------------------------
# Proactive Redshift monitor — set these AND deploy with
#   cdk deploy RedshiftMonitorStack -c enableProactiveMonitors=true
# to enable the custom.redshift alerting path.
# ------------------------------------------------------------------
REDSHIFT_CLUSTER_ID=
REDSHIFT_DATABASE=
REDSHIFT_DB_USER=

# ------------------------------------------------------------------
# Proactive DMS monitor — set these AND deploy with
#   cdk deploy DmsMonitorStack -c enableProactiveMonitors=true
# DMS_LOG_HOURS_BACK is the lookback window for CloudWatch ]E: log scans;
# default 24h.
# ------------------------------------------------------------------
DMS_TASK_ARN=
DMS_LOG_GROUP=
DMS_LOG_HOURS_BACK=24
